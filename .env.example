# Every key the app reads (core/config.py). No values here — copy to .env and fill in.

# Postgres. Locally: postgresql://askmanual:<password>@localhost:5432/askmanual
DATABASE_URL=

# Qdrant. Locally: http://localhost:6333. Leave empty to run Qdrant embedded on disk
# at QDRANT_PATH (default index/qdrant): no Docker needed, one process at a time.
QDRANT_URL=
QDRANT_PATH=
# Only needed for Qdrant Cloud; leave empty for the local container.
QDRANT_API_KEY=

# Read by docker-compose.yml to initialise the local Postgres container.
POSTGRES_PASSWORD=

# Which /ask backend runs: "fixture" (AS0.5 stubs, default) or "real" (AS4.3 pipeline).
PIPELINE=

# Generation. Needed only for PIPELINE=real and `eval.run --answers`.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5.
LLM_MODEL=
# Seconds before /ask gives up with a 504. Default 45.
GENERATION_TIMEOUT=

# Retrieval. Registry name /ask uses (retrieval/registry.py), default "fused".
RETRIEVER=
# AS3.2 output from `python -m eval.calibrate`. Default 0 (never refuse).
REFUSAL_THRESHOLD=
# Defaults: BAAI/bge-small-en-v1.5 and "chunks". Change both together — the collection is model-specific.
EMBED_MODEL=
QDRANT_COLLECTION=

# Ingest artifacts. Defaults: ./chunks.jsonl, ./pages, ./index/bm25.pkl
CHUNKS_PATH=
PAGES_DIR=
BM25_PATH=
